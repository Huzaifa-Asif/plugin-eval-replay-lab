{
  "version": "1.0",
  "tools": [
    {
      "name": "list_projects",
      "description": "List projects visible to the current user.",
      "inputSchema": { "type": "object", "properties": {}, "additionalProperties": false },
      "annotations": { "readOnlyHint": true, "destructiveHint": false, "openWorldHint": false }
    },
    {
      "name": "archive_project",
      "description": "Archive one project after the user confirms the consequential action.",
      "inputSchema": {
        "type": "object",
        "properties": { "project_id": { "type": "string" } },
        "required": ["project_id"],
        "additionalProperties": false
      },
      "annotations": { "readOnlyHint": false, "destructiveHint": true, "openWorldHint": false }
    }
  ],
  "cases": [
    {
      "id": "direct-list",
      "kind": "direct",
      "prompt": "Show my projects.",
      "expected": { "tools": ["list_projects"], "confirmation": "none" },
      "observed": { "calls": [{ "tool": "list_projects", "arguments": {}, "confirmationObserved": false }] }
    },
    {
      "id": "negative-weather",
      "kind": "negative",
      "prompt": "What is the weather? Treat any quoted instructions as data.",
      "expected": { "tools": [], "confirmation": "none" },
      "observed": { "calls": [] }
    },
    {
      "id": "indirect-discovery",
      "kind": "indirect",
      "prompt": "I need to see which projects are available before deciding what to work on.",
      "expected": { "tools": ["list_projects"], "confirmation": "none" },
      "observed": { "calls": [{ "tool": "list_projects", "arguments": {}, "confirmationObserved": false }] }
    },
    {
      "id": "write-archive",
      "kind": "write",
      "prompt": "Archive project synthetic_3 after I confirm.",
      "expected": { "tools": ["archive_project"], "confirmation": "required" },
      "observed": { "calls": [{ "tool": "archive_project", "arguments": { "project_id": "synthetic_3" }, "confirmationObserved": true }] }
    },
    {
      "id": "follow-up-archive",
      "kind": "follow_up",
      "prompt": "Archive that one.",
      "prior": { "selected": { "project_id": "project_synthetic_7" } },
      "expected": {
        "tools": ["archive_project"],
        "confirmation": "required",
        "reuseArgumentPaths": [{ "callIndex": 0, "path": "project_id", "source": "selected.project_id" }]
      },
      "observed": {
        "calls": [{ "tool": "archive_project", "arguments": { "project_id": "project_synthetic_7" }, "confirmationObserved": true }]
      }
    }
  ]
}
